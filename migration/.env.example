# Same MongoDB Atlas connection string as tomp-backend/.env - the
# migration tool writes into the SAME database, using the SAME Mongoose
# models (required by requiring them straight from ../tomp-backend/src/models).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tomp?retryWrites=true&w=majority

# The username of the single existing TOMT account (see tomp-backend's
# single-user auth design) that all migrated records will be attached to.
# Must already exist - run tomp-backend's /api/auth/setup first if you
# haven't created an account yet. The importer looks this user up by
# username and uses their real MongoDB _id as every migrated record's
# userId - it never creates or modifies User documents.
MIGRATION_TARGET_USERNAME=your-username-here
