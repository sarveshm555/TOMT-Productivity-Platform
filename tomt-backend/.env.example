# ------------------------------------------------------------------
# TOMP Backend - Environment Variables
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (GridFS buckets are created on the
# same database automatically - no separate config needed).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tomp?retryWrites=true&w=majority

# JWT secrets - use two DIFFERENT long random strings.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Frontend origin allowed to call this API with credentials (cookies).
# Local dev default shown; set to the Vercel deployment URL in production.
CLIENT_ORIGIN=http://localhost:5173
